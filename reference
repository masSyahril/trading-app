// ===designed by Prof Wang, 2025-Oct-16=================================
//KD隨機指標(Stochastic Indicator)。  0<=K,D<=100.
//function computeKD(STK_high, STK_low, STK_close, KD_day, KD_K, KD_D)
function computeKD(STK_high, STK_low, STK_close, KD_day) {
  const KD_K = [];
  const KD_D = [];
  for (let i = KD_day - 1; i < STK_close.length; i++) {
    let maxHigh = STK_high[i];
    let minLow = STK_low[i];
    for (let j = 1; j < KD_day; j++) {
      maxHigh = Math.max(maxHigh, STK_high[i - j]);
      minLow = Math.min(minLow, STK_low[i - j]);
    }
    let rsv;
    if (maxHigh === minLow) {
      rsv = 100;
    } else {
      rsv = ((STK_close[i] - minLow) / (maxHigh - minLow)) * 100;
    }
    if (i === KD_day - 1) {
      KD_K[i] = 50;
      KD_D[i] = 50;
    } else {
      KD_K[i] = (2 / 3) * KD_K[i - 1] + (1 / 3) * rsv;
      KD_D[i] = (2 / 3) * KD_D[i - 1] + (1 / 3) * KD_K[i];
    }
  }
  return { KD_K, KD_D };
  //drawing the KD-line figures in the small windows.
  //if day=9,  KD_K(),KD_D()=9,10,...,2000.
}
