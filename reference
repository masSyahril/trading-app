//ePVT今=(n-1)/(n+1)*ePVT昨+2/(n+1)*PVT今。參數=9,<本人自創>
function computePVT() {
  const PVT=[], ePVT=[];
  let ePVT_n=9;    //指數平滑移動平均參數=9
  PVT(1)=STK_vol(1);   //初值
  ePVT(1)=PVT(1);      //初值,指數平滑移動平均
  for(let i=2; i<STK_close.length; i+1) {
    PVT(i)=PVT(i-1)+((STK_close(i)-STK_close(i-1))/STK_close(i-1))*STK_vol(i);
    ePVT(i)=(ePVT_n-1)/(ePVT_n+1)*ePVT(i-1)+2/(ePVT_n+1)*PVT(i);
    //ePVT今=(n-1)/(n+1)*ePVT昨+2/(n+1)*PVT今。參數=9,<本人自創>
  }
  return PVT(), ePVT();
  //drawing the PVT and ePVT figures in the small windows.
  //PVT, ePVT=1,2,3,...,2000.
}
