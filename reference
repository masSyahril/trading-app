//ATR均幅指標(ATR, Average True Range) indicator.
//ATR()=sum(TR)/n
//function computeATR(ATR, TR, smoothed_n)
function computeATR(smoothed_n) {
  // TR(i) = 2,3,...,2000.
  let ATR = [];  //需要設定嗎？
  let TR = [];   //需要設定嗎？
  for(let i = 2; i < STK_close.length; i++) {
    const temp1 = STK_high[i] - STK_low[i];
    const temp2 = Math.abs(STK_high[i] - STK_close[i - 1]);
    const temp3 = Math.abs(STK_low[i] - STK_close[i - 1]);
    TR[i] = Math.max(temp1, temp2, temp3);
    if(i === 2){
      ATR[1] = TR[2];
    }
  }
  for(let i = 2; i < STK_close.length; i++) {
    ATR[i] = (smoothed_n-1)/(smoothed_n+1)*ATR[i-1] + 2/(smoothed_n+1)*TR[i];
  }
}
