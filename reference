// ===designed by Prof Wang, 2025-Nov-01=================================
//ADI漲跌力道聚散指標。
//今日收盤價「大於」昨日收盤價，則今日ADI=昨日ADI＋[今日收盤價－Min(今日最低價，昨日收盤價)]
//否則今日ADI=昨日ADI－[Max(今日最高價，昨日收盤價)－今日收盤價]
//function computeADI(ADI, ADIs, ADI_day)
// NOTE: Returns 2 values (ADI and ADIs) - shows 2 lines
function computeADI(ADI_day) {
  const ADI = [];
  const ADIs = [];  //這二個要宣告嗎?
  ADI[0] = 0;       //ADI(1)初值=0 (index 0 = first element)
  for (let i = 1; i < STK_close.length; i++) {
    if (STK_close[i] > STK_close[i-1]) {
      ADI[i] = ADI[i-1] + (STK_close[i] - Math.min(STK_low[i], STK_close[i-1]));
    } else if (STK_close[i] < STK_close[i-1]) {
      ADI[i] = ADI[i-1] - (Math.max(STK_high[i], STK_close[i-1]) - STK_close[i]);
    } else {
      ADI[i] = ADI[i-1] + 0;
    }
    ADIs[i] = (ADI_day-1)/(ADI_day+1)*ADI[i-1] + 2/(ADI_day+1)*ADI[i];
    //ADIs()是ADI()的平滑化，即：(n-1)/(n+1)*昨+(2/(n+1)*今
  }
  return { ADI, ADIs };
  //drawing the ADI() and ADIs() figures in the small windows.
  //ADI(), ADIs()=2,3,...,2000.
}
