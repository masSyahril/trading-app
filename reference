// ===designed by Prof Wang, 2025-Oct-26=================================
//UOSC終極振盪指標(UOSC, Ultimate Oscillator)
//UOSC1=[sum(C-MA)]/m 。 UOSC1=[sum(C/MA)]/m
//function computeUOSC(UOSC1, UOSC2, MA_day, UOSC_num)
function computeUOSC(MA_day, UOSC_num){
  const UOSC1 = [];
  const UOSC2 = [];
  const OSC1 = [];
  const OSC2 = [];
  const MA = computeMA(STK_close, MA_day);
  for (let i = MA_day; i < STK_close.length; i++) {
    OSC1[i] = STK_close[i] - MA[i];
    OSC2[i] = STK_close[i] / MA[i];
  }
  let sum1 = 0;
  let sum2 = 0;
  for (let i = MA_day; i < MA_day + UOSC_num; i++) {
    sum1 += OSC1[i];
    sum2 += OSC2[i];
  }
  // first UOSC1, UOSC2 values
  UOSC1[MA_day + UOSC_num - 1] = sum1 / UOSC_num;
  UOSC2[MA_day + UOSC_num - 1] = sum2 / UOSC_num;
  for (let i = MA_day + UOSC_num; i < STK_close.length; i++) {
    sum1 += OSC1[i] - OSC1[i - UOSC_num];
    sum2 += OSC2[i] - OSC2[i - UOSC_num];
    UOSC1[i] = sum1 / UOSC_num;
    UOSC2[i] = sum2 / UOSC_num;
  }
  return { UOSC1, UOSC2 };
}
