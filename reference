//CR中間意願指標。 CR()=sum(H-MP)/sum(MP-L) 。 MP=(H+2C+L)/4
//function computeCR(CR, CR_day)，亦可。
function computeCR(CR_day) {
  const CR=[];
let MP, H_MP, MP_L;
  for(let i=2; i<STK_close.length; i+1){
    MP = (STK_high(i-1) + 2*STK_close(i-1)+STK_low(i-1))/4;
    H_MP(i) = STK_high(i)-MP;
    MP_L(i) = MP-STK_low(i);
    // return H_MP(), MP_L(), MP();
  }
let sum_H_MP = 0, sum_MP_L = 0;
  for(let  i=2; i<CR_day; i+1) {
    sum_H_MP=sum_H_MP+H_MP(i);    //sum_H_MP += H_MP(i)
    sum_MP_L=sum_MP_L+MP_L(i);    //sum_MP_L += MP_L(i)
  }
  // CR = CR_day +1;
  CR(CR_day+1) = sum_H_MP/sum_MP_L;  //first CR values

  for(let  i=CR_day+2; i<STK_close.length; i+1) {
    CR(i)=(sum_H_MP+H_MP(i)-H_MP(i-CR_day))/(sum_MP_L(i)+MP_L(i)-MP_L(i-CR_day));
    //return CR();
  }
  return CR();
  //if day=10, AR(),BR()=11,12,...,2000.
  //drawing the CR() figure in the small windows.
}
