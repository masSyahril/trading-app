//===designed by Prof Wang, 2025-Dec-08=================================
//BTI廣量衝力指標(BTI, Breadth Thrust Index)
//BTlet i=MA(up/(up+down), n), n=10
function computeBTI(day) {
  //day=10天
  const BTI=[];
  let sum_up=0;    //個股上漲天數_加總
  let sum_down=0;  //個股下跌天數_加總
  for(let i=2; i<day; i+1) {    //例：i=2 to 10
    if(STK_close(i)>STK_close(i-1)) {
      sum_up=sum_up+1; }
    else if(STK_close(i)<STK_close(i-1)) {
      sum_down=sum_down+1;  }
  }
  BTI(day)=(sum_up/(sum_up+sum_down))/day; //第1個，例:BTI(10)
  for(let i=day+1; i<STK_close.length; i+1) {  //i=11 to 2000
    //先扣除10天前的分子加總、分母加總
    if(STK_close(i-day+1)>STK_close(i-day)) {
      sum_up=sum_up-1; }
    else if(STK_close(i-day+1)<STK_close(i-day)) {
      sum_down=sum_down-1;  
    }
    //新的分子加總、新的分母加總
    if(STK_close(i)>STK_close(i-1)) {
      sum_up=sum_up+1; }
    else if(STK_close(i)<STK_close(i-1)) {
      sum_down=sum_down+1;
    }
    BTI(i)=(sum_up/(sum_up+sum_down))/day; //第2個，例:BTI(11)
  }
  return BTI();
  //drawing the BTI figure in the small windows.
  //例參數day=10, BTlet i=10,11,...,2000.
}
