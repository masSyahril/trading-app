//===designed by Prof Wang, 2025-Dec-03=================================
//ADR漲跌比率(ADR, Advance Decline Ratio)。
//ADRt=N日內上漲天數總和/N日內下跌天數總和
// NOTE: Returns 1 value - shows 1 line
function computeADR(ADR_day) {
  const ADR = [];
  let Up_days = 0, Dn_days = 0;  //上漲天數，下跌天數
  //例ADR_day=20，計算1,2,...,20的漲跌天數
  for(let i = 1; i < ADR_day; i++) {    //例：let i=1,2,...,19
    if(STK_close[i] > STK_close[i-1]) {
      Up_days = Up_days + 1;
    } else if(STK_close[i] < STK_close[i-1]) {
      Dn_days = Dn_days + 1;
    }  
  }
  if(Dn_days === 0) {             //分母為0時的處理方式，取N日值.
    ADR[ADR_day-1] = ADR_day;   //ADR(20)，第1個ADR (index 19)。
  } else {
    ADR[ADR_day-1] = Up_days/Dn_days;
  }
  //計算其餘的ADR=21,22,...,2000
  for(let i = ADR_day; i < STK_close.length; i++) {    //例：let  i=20,21,...,2000.
    //先扣掉第2天比第1天是否漲跌的天數。
    const oldIdx = i - ADR_day + 1;
    if(STK_close[oldIdx] > STK_close[oldIdx-1]) {  //第2天比第1天是否漲
      Up_days = Up_days - 1;
    } else if(STK_close[oldIdx] < STK_close[oldIdx-1]) {
      Dn_days = Dn_days - 1;
    } 
    //第21天比第20天是否漲。
    if(STK_close[i] > STK_close[i-1]) { 
      Up_days = Up_days + 1;
    } else if(STK_close[i] < STK_close[i-1]) {
       Dn_days = Dn_days + 1;
    } 

    if(Dn_days === 0) {         //分母為0，取N日值.
      ADR[i] = ADR_day;     //ADR(21)，第2個ADR。
    } else {
      ADR[i] = Up_days/Dn_days;
    }
  }
  return ADR;
  //drawing the ADR figure in the small windows.
  //例參數day=20, ADR=20,21,...,2000.
}
