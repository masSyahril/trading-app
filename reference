//VHF垂直水平過濾指標(Vertical Horizontal Filter Indicator)。(VHF十字過濾線指標)
//1.找出一定計算期間內(N期)的最高收盤價及最低收盤價。HP=N期內最高收盤價，LP=N期內最低收盤價。
//2.取HP與LP之間的價差，作為指標的分子部份。分子=HP–LP。
//3.將計算期內的各日收盤價減去前一日收盤價求其價差，將各日價差皆取絕對值，最後再將其加總，
//此一加總值即為指標的分母部份。分母=Sum of(｜收盤價j－收盤價j-1｜)；j=1 to n。
//4.VHF=分子/分母。一般可取14天或28天。
//function computeVHF(VHF, VHFs, VHF_day)
// NOTE: Returns 2 values (VHF and VHFs) - shows 2 lines
function computeVHF(VHF_day) {
  const VHF = [];    //這個要宣告嗎？
  const VHFs = [];   //這個要宣告嗎？平滑化後的陣列
  const smoothed = 10;  //平滑的天數
  let sum = 0;
  for (let i = 0; i < STK_close.length - VHF_day + 1; i++) {
    let max_close = STK_close[i];  //令第一筆為max
    let min_close = STK_close[i];  //令第一筆為min
    sum = 0;
    for (let j = i; j < i + VHF_day; j++) {   //例參數VHF_day=20，從i找到i+19
      if (STK_close[j] > max_close) {
        max_close = STK_close[j];         //例參數為20，在i~i+19找max,min
      }
      if (STK_close[j] < min_close) {
        min_close = STK_close[j];
      }
      if (j > i) {
        sum = sum + Math.abs(STK_close[j] - STK_close[j-1]); //累加(今收-昨收)
      }
    }
    const idx = i + VHF_day - 1; //例第一筆=VHF(19) when i=0, VHF_day=20
    if (sum !== 0) {
      VHF[idx] = Math.abs(max_close - min_close) / sum;
    } else {
      VHF[idx] = 0;
    }
    if (i > 0) {
      VHFs[idx] = (smoothed-1)/(smoothed+1)*VHF[idx-1] + 2/(smoothed+1)*VHF[idx];
    } else {
      VHFs[idx] = VHF[idx]; // First value
    }
  }
  return { VHF, VHFs };
  //drawing the VHF and VHFs figures in the small windows.
  //例參數VHF_day=20, VHF()=20,21,...,2000 , VHFs()=21,22,...,2000.
}
