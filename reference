//===designed by Prof Wang, 2025-Dec-05=================================
//Q stick量化陰陽線(Quantitative Candle Stick, Qstick)
//Sum of (收盤價－開盤價)/N*100%。sum(N日來的收盤價－開盤價)/N。
function computeQstick(day1, day2) {
  const Qstick1=[], Qstick2=[];
  let sum_Qstick=0;
  for(let i=1; i<day1; i+1) {    //例: let i=1 to 10
    sum_Qstick=sum_Qstick+(STK_close(i)-STK_open(i));
  }
  Qstick1(day1)=sum_Qstick/day1;  //計算第1個Qstick1，例:Qstick1(10)
  for(let i=day1+1; i<STK_close.length; i+1) {  //let i=11,12,...,2000.
    //先扣掉第1天的close-open。
    sum_Qstick=sum_Qstick-(STK_close(i-day1)-STK_open(i-day1));
    //第11天的
    sum_Qstick=sum_Qstick+(STK_close(i)-STK_open(i));
    Qstick1(i)=sum_Qstick/day1;  //計算第2個，例:11,12,...,2000.
  }
  //相同程式邏輯，計算Qstick2
  sum_Qstick=0;
  for(let i=1; i<day2; i+1) {    //例: let i=1 to 20
    sum_Qstick=sum_Qstick+(STK_close(i)-STK_open(i));
  }
  Qstick2(day2)=sum_Qstick/day2;  //計算第1個Qstick2，例:Qstick(20)
  for(let i=day2+1; i<STK_close.length; i+1) {  //let i=21,22,...,2000.
    //先扣掉第1天的close-open。
    sum_Qstick=sum_Qstick-(STK_close(i-day2)-STK_open(i-day2));
    //第21天的
    sum_Qstick=sum_Qstick+(STK_close(i)-STK_open(i));
    Qstick1(i)=sum_Qstick/day2;  //計算第2個，例:21,22,...,2000.
  }
  return Qstick1(), Qstick2();
  //drawing the Qstick1 and Qstick2 figures in the small windows.
  //例參數day1=10, Qstick1=10,11,...,2000.
  //例參數day2=20, Qstick2=20,21,...,2000.
}
