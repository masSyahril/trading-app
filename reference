//VRMA移動平均變動率指標(VRMA, Variant Rate of Moving Average)
//<完全自創指標,中英文自命名, 2009-April-11>
//VRMA=(MA(t)-MA(t-1))/MA(t-1))
// NOTE: Returns 2 values (VRMA1 and VRMA2) - shows 2 lines
function computeVRMA(day1, day2) {      //MA_day1, MA_day2
  const VRMA1 = [];             //例：VRMA1=5日MA變動率，VRMA2=10的MA變動率
  const VRMA2 = [];
  const MA1 = computeMA(STK_close, day1);
  const MA2 = computeMA(STK_close, day2);
  for(let i = day1; i < STK_close.length; i++) {  //例：VRMA1=5日的MA變化率
    if (MA1[i-1] !== 0 && MA1[i-1] !== null && MA1[i] !== null) {
      VRMA1[i] = (MA1[i] - MA1[i-1]) / MA1[i-1];    //例：VRMA1=6,7,...,2000.
    } else {
      VRMA1[i] = 0;
    }
  }
  for(let i = day2; i < STK_close.length; i++) {  //例：VRMA2=10日的MA變化率
    if (MA2[i-1] !== 0 && MA2[i-1] !== null && MA2[i] !== null) {
      VRMA2[i] = (MA2[i] - MA2[i-1]) / MA2[i-1];    //例：VRMA2=11,12,...,2000.
    } else {
      VRMA2[i] = 0;
    }
  }
  return { VRMA1, VRMA2 };
  //drawing the VRMA1 and VRMA2 figures in the small windows.
  //例參數day1=5, VRMA1=6,7,...,2000.
  //例參數day2=10,VRMA2=11,12,...,2000.
}
