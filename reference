    MTM2(i)=STK_close(i)/STK_close(i-day2+1)*100;
    //例:day2=20, MTM2(20)=close(20)/close(1)*100
    //MTM2=20,21,...,2000.
  }
  return MTM1(), MTM2();
  //drawing the MTM1 and MTM2 figures in the small windows.
  //例參數day1=10, MTM1=10,11,...,2000.
  //例參數day2=20, MTM2=20,21,...,2000.
}
