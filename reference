//VR成交量比率(VR, Volume Ratio)
//計算式：VR=(UpVol+TtlVol/2)/(DnVol+TtlVol/2)*100
//UpVol為期間內股價上漲日的成交量累積值。DnVol為期間內股價下跌日的成交量累積值。
//TtlVol則為期間內各日成交量的累積值。一般取26日為計算區間。
//function computeVR(VR, VRs, VR_day)
// NOTE: Returns 2 values (VR and VRs) - shows 2 lines
function computeVR(VR_day) {
  //一般取VR_day=26日為計算區間
  const VR = [];    //這個要宣告嗎？
  const VRs = [];   //這個要宣告嗎？平滑化後的陣列
  const smoothed = 10;  //平滑的天數
  let UpVol = 0, DnVol = 0, TtlVol = 0;
  //上漲日的成交量累積值UpVol,下跌日的成交量累積值DnVol,期間內各日成交量的累積值TtlVol=0
  // UpVol=STK_vol(1);
  // DnVol=STK_vol(1);
  VR[VR_day-1] = 100;       //初值三個均設為第一天的成交量，此時初值VR=100。VR(20)=100 (index 19)
  //第一輪先算第一個VR,假設VR_day=20,則j=1 to 20,算出第一個VR(20)
  for (let j = 1; j < VR_day; j++) {          // j=1 to 19 (first round, indices 1-19)
    if (STK_close[j] >= STK_close[j-1]) {   //上漲
      UpVol = UpVol + STK_vol[j];  }          //累加第一個上漲成交量STK_vol(1)
    if (STK_close[j] <= STK_close[j-1]) {   //下跌
      DnVol = DnVol + STK_vol[j];  }          //累加第一個下跌成交量STK_vol(1)
    TtlVol = TtlVol + STK_vol[j];             //每天成交量的累積值
  }
  if (DnVol + TtlVol/2 !== 0) {
    VR[VR_day] = (UpVol + TtlVol/2) / (DnVol + TtlVol/2) * 100;  //第一個VR(20) (index 20)
  } else {
    VR[VR_day] = 100;
  }
  VRs[VR_day] = (smoothed-1)/(smoothed+1)*VR[VR_day-1] + 2/(smoothed+1)*VR[VR_day];
  //第一個平滑VRs(20)。 VRs(20)=(n-1)/(n+1)*VR(19)+2/(n+1)*VR(20)

  for (let i = VR_day + 1; i < STK_close.length; i++) {   //let i=21 to 2000, 設VR_day=20
    //先扣除20天前累積的成交量
    const oldIdx = i - VR_day;
    if (STK_close[oldIdx] >= STK_close[oldIdx-1]) {  //上漲
      UpVol = UpVol - STK_vol[oldIdx];  }                //扣除第一個上漲成交量STK_vol(1)
    if (STK_close[oldIdx] <= STK_close[oldIdx-1]) {  //下跌
      DnVol = DnVol - STK_vol[oldIdx];  }               //扣除第一個下跌成交量STK_vol(1)
    TtlVol = TtlVol - STK_vol[oldIdx];                  //扣除第一個每天成交量的累積值
    //例VR_day=20,第一次進入迴圈,let i=21,三個累積值變數要扣除對應的第一個成交量,即STK_vol(1)
   
    if (STK_close[i] >= STK_close[i-1]) {   //上漲 
      UpVol = UpVol + STK_vol[i];  }          //累加第2個上漲成交量STK_vol(21)
    if (STK_close[i] <= STK_close[i-1]) {   //下跌
      DnVol = DnVol + STK_vol[i];  }          //累加第2個下跌成交量STK_vol(21)
    TtlVol = TtlVol + STK_vol[i];             //每天成交量的累積值
    if (DnVol + TtlVol/2 !== 0) {
      VR[i] = (UpVol + TtlVol/2) / (DnVol + TtlVol/2) * 100; //第2個VR是VR(21)
    } else {
      VR[i] = 100;
    }
    VRs[i] = (smoothed-1)/(smoothed+1)*VR[i-1] + 2/(smoothed+1)*VR[i];
    //例參數VR_day=20，則第一筆平滑VRs=VRs(20),但第一筆VR=VR(19)
  }
  return { VR, VRs };
  //drawing the VR and VRs figures in the small windows. 
  // normally drawing in K-line area.
  //例參數VR_day=20, VR()=20,21,...,2000 , VRs()=20,21,...,2000.
}
