// ===designed by Prof Wang, 2025-Nov-08=================================
//DEMA指標(Double Exponential Moving Average)
//DEMA＝2*N日EMA－N日EMA的EMA。即：DEMA=2*EMA-EMA(EMA).
//function computeDEMA(EMA, DEMA, day)
// NOTE: Returns 2 values (DEMA and EMA) - shows 2 lines
function computeDEMA(day) {
  const EMA = [];     //這個要宣告嗎？
  const DEMA = [];    //這個要宣告嗎？
  //day=平滑的天數，設=20
  //計算第一個EMA(),DEMA()
  let yesterday_doubleEMA; //昨天的doubleEMA
  let today_doubleEMA;     //今天的doubleEMA
  let sum = 0;
  for(let i = 0; i < day; i++) {     //例如：let i=0 to 19
    sum = sum + STK_close[i];
  }
  EMA[day-1] = sum/day;    //第一個EMA(20) (index 19)
  DEMA[day-1] = sum/day;   //第一個DEMA(20) (index 19)
  yesterday_doubleEMA = sum/day;  //昨天的第一個doubleEMA
  //計算EMA,DEMA=21,22,...,2000
  for(let i = day; i < STK_close.length; i++) {
    EMA[i] = (day-1)/(day+1)*EMA[i-1] + (2/(day+1))*STK_close[i];
    today_doubleEMA = (day-1)/(day+1)*yesterday_doubleEMA + (2/(day+1))*EMA[i];
    DEMA[i] = 2*EMA[i] - today_doubleEMA;
    yesterday_doubleEMA = today_doubleEMA;  //今日的雙EMA變數丟給昨日的雙EMA變數
  }  //平滑式=(n-1)/(n+1)*昨+2/(n+1)*今
     //double EMA採用與EMA同步方式計算，不再落後day期。
  return { DEMA, EMA };
  //drawing the DEMA() and EMA() figures in the small windows.
  //例參數day=20, DEMA()=EMA()=20,21,...,2000.
}
