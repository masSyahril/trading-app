// ===designed by Prof Wang, 2025-Nov-02=================================
//HLO高低價擺盪指標，全名為「High/Low Oscillator」，用來衡量每日價格波動的真實幅度。
//1.TRt=MAX((Ht-Lt), (Ht- Ct-1), (Lt-Ct-1))
//2.HLOt=(Ht-Ct-1)/TRt*100
//function computeHLO(HLO, HLOs, HLO_day)
// NOTE: Returns 2 values (HLO and HLOs) - shows 2 lines
function computeHLO(HLO_day) {
  const HLO = [];   //這個要宣告嗎？
  const HLOs = [];  //這個要宣告嗎？
  HLO[0] = 50;      //HLO(1)初值=50,適當否？ (index 0 = first element)
  for (let i = 1; i < STK_close.length; i++) {
    const TR = Math.max(
      STK_high[i] - STK_low[i], 
      STK_high[i] - STK_close[i-1], 
      Math.abs(STK_low[i] - STK_close[i-1])
    );
    if (TR !== 0) {
      HLO[i] = (STK_high[i] - STK_close[i-1]) / TR * 100;
    } else {
      HLO[i] = 50;
    }
    HLOs[i] = (HLO_day-1)/(HLO_day+1)*HLO[i-1] + 2/(HLO_day+1)*HLO[i];
    //HLOs()是HLO()的平滑化，即：(n-1)/(n+1)*昨+(2/(n+1)*今
  }
  HLOs[0] = HLO[0]; // Initialize first HLOs value
  return { HLO, HLOs };
  //drawing the HLO and HLOs figures in the small windows.
  //HLO(), HLOs()=2,3,...,2000.
}
