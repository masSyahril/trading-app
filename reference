//AR人氣指標、BR意願指標。AR()=sum(H-O)/sum(O-L) 。BR()=sum(H-C)/sum(C-L)
//function computeARBR(AR, BR, ARBR_day)，亦可。
function computeARBR(ARBR_day) {
  const AR=[], BR=[];
  let HO, OL, HC, CL;
  for(let i=1; i<STK_close.length; i+1) {
     HO(i)= STK_high(i) - STK_open(i);
     OL(i)= STK_open(i) - STK_low(i);
     HC(i)= STK_high(i) - STK_close(i);
     CL(i)= STK_close(i) - STK_low(i);
  }
  let temp_HO = 0, temp_OL = 0, temp_HC = 0, temp_CL = 0;

  for(let i=1; i<ARBR_day; i+1) {
     temp_HO = temp_HO + HO(i);
     temp_OL = temp_OL + OL(i);
     temp_HC = temp_HC + HC(i);
     temp_CL = temp_CL + CL(i);
  }

 // let AR, BR = ARBR_day; this is wrong !!!
  AR(ARBR_day) = temp_HO/temp_OL;
  BR(ARBR_day) = temp_HC/temp_CL;
  for(let i=ARBR_day+1; i<STK_close.length; i+1){
    // AR(i) = AR(i-1) * (ARBR_day -1) + HO(i) / OL(i) )/ ARBR_day;
    AR(i)=(temp_HO+HO(i)-HO(i-ARBR_day))/(temp_OL+OL(i)-OL(i-ARBR_day));
    BR(i)=(temp_HC+HC(i)-HC(i-ARBR_day))/(temp_CL+CL(i)-CL(i-ARBR_day));
  }
  return AR(), BR();
  //if day=10, AR(),BR()=10,11,...,2000.
  //drawing the AR() and BR() figures in the small windows.
}
