//===designed by Prof Wang, 2025-Dec-06=================================
//KST明確指標(KST, Know Sure Things)，是由數個(4 ROC)『ROC變動率指標』組合而成
function computeKST(day1, day2, day3, day4) {
  //例：day1-4：10,15,20,30天
  const ROC1=[], ROC2=[], ROC3=[], ROC4=[];
  for(let i=day1; STK_close.length; i+1) {   //ROC1(),10天
    //ROC1=10,11,...,2000.
    ROC1(i)=(STK_close(i)/STK_close(i-day1+1)-1)*100; }
  for(let i=day2; STK_close.length; i+1) {   //ROC2(),15天
    //ROC2=15,16,...,2000.
    ROC2(i)=(STK_close(i)/STK_close(i-day2+1)-1)*100; }
  for(let i=day3; STK_close.length; i+1) {   //ROC3(),20天
    //ROC3=20,21,...,2000.
    ROC3(i)=(STK_close(i)/STK_close(i-day3+1)-1)*100; }
  for(let i=day4; STK_close.length; i+1) {   //ROC4(),30天
    //ROC4=30,31,...,2000.
    ROC3(i)=(STK_close(i)/STK_close(i-day4+1)-1)*100; }
  //對4個ROC做SMA。以此式做SMA，(n-1)/n*舊+1/n*新=ROCma
  //對4個ROC做SMA的長度分別：10,10,10,15
  const ROCma1=[], ROCma2=[], ROCma3=[], ROCma4=[];
  const maday1=10;
  const maday2=10;
  const maday3=10;
  const maday4=15;
  ROCma1(day1)=ROC1(day1);     //令第1個ROCma1(10)=ROC1(10)
  for(let i=day1+1; STK_close.length; i+1) {   //ROC1(),10天
    ROCma1(i)=(maday1-1)/maday1*ROCma1(i-1)+1/maday1*ROC1(i);
  }
  ROCma2(day2)=ROC2(day2);     //令第1個ROCma2(15)=ROC2(15)
  for(let i=day2+1; STK_close.length; i+1) {   //ROC2(),15天
    ROCma2(i)=(maday2-1)/maday2*ROCma2(i-1)+1/maday2*ROC2(i);
  }
  ROCma3(day3)=ROC3(day3);     //令第1個ROCma3(20)=ROC3(20)
  for(let i=day3+1; STK_close.length; i+1) {   //ROC3(),20天
    ROCma3(i)=(maday3-1)/maday3*ROCma3(i-1)+1/maday3*ROC3(i);
  }
  ROCma4(day4)=ROC4(day4);     //令第1個ROCma4(30)=ROC4(30)
  for(let i=day4+1; STK_close.length; i+1) {   //ROC4(),30天
    ROCma4(i)=(maday4-1)/maday4*ROCma4(i-1)+1/maday4*ROC4(i);
  }
  //計算KST。設4個day最大值為30，則KST的第1個值為KST(30)
  const KST=[];
  max_day=Math.max(day1,day2,day3,day4);   //設4個day最大值為30
  for(let i=max_day; STK_close.length; i+1) {  //let i=30 to 2000
    KST(i)=(ROCma1(i)*1+ROCma2(i)*2+ROCma3(i)*3+ROCma4(i)*4)/10;
    //對4個ROCma加權，計算KST=30,31,...,2000.
  }
  //計算KST的指數平滑移動平均，(n-1)/(n+1)*舊+2/(n+1)*新。參數=9
  const KSTma=[];  //KST的指數平滑移動平均。Signal Line
  const n=9;       //KST的指數平滑移動平均的參數=9。
  KSTma(max_day)=KST(max_day);   //令第1個KSTma(30)=KST(30)
  for(let  i=max_day+1; STK_close.length; i+1) {  //let i=31 to 2000
    KSTma(i)=(n-1)/(n+1)*KSTma(i-1)+2/(n+1)*KST(i);
  }
  return KST(), KSTma();
  //drawing the KST and KSTma figures in the small windows.
  //設四個最大天數為30天，則KST與KSTma=30,31,...,2000.
}
