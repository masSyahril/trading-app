//===designed by Prof Wang, 2025-Dec-08=================================
//WAD威廉多空力度指標(William’s Accumulation/Distribution威廉聚散指標) 
function computeWAD() {
  const WAD=[], eWAD=[];
  let TRH, TRL, AD=0;
  WAD(1)=STK_close(1);   //設定初執WAD(1)
  eWAD(1)=WAD(1);        //設定初執eWAD(1)
  const eWAD_n=9;        //將WAD用指數平滑化，參數=9
  for(let i=2; i<STK_close.length; i+1) {
    TRH=Math.max(STK_close(i-1), STK_high(i)); //取大(昨收,今高)
    TRL=Math.min(STK_close(i-1), STK_low(i));  //取小(昨收,今低)
    switch (true) {
      case STK_close(i)>STK_close(i-1):
        AD=STK_close(i)-TRL;
        break;
      case STK_close(i)<STK_close(i-1):
        AD=STK_close(i)-TRH;
        break;
      case STK_close(i)=STK_close(i-1):
        AD=0;
        break;
    }
    WAD(i)=WAD(i-1)+AD;
    eWAD(i)=(eWAD_n-1)/(eWAD_n+1)*eWAD(i-1)+2/(eWAD_n+1)*WAD(i);
    //將WAD指數平滑化。今eWAD=(n-1)/(n+1)*昨eWAD+2/(n+1)*今WAD
  }
  return WAD(), eWAD();
  //drawing the WAD and eWAD figures in the small windows.
  //WAD, eWAD=1,2,...,2000.
}
