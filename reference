//===designed by Prof Wang, 2025-Dec-10=================================
//EOM(EMV)簡易波動指標(Ease of Movement)
function computeEOV() {
  const EOM=[], eEOM=[];
  let eEOM_n=9;    //指數平滑移動平均參數=9
  for(let i=2; i<STK_close.length; i+1) {
    //MID=MidPointMove
    let MID=(STK_high(i)-STK_low(i))/2-(STK_high(i-1)-STK_low(i-1))/2;
    //VPU=VolumePerUnit
    let VPU=STK_vol(i)/(STK_high(i)-STK_low(i));
    //compute EOM(EMV)
    EOM(i)=MID/VPU*1000;
    if(i=2){               //指數平滑移動平均
      eEOM(2)=EOM(2); }    //eEOM初值
    else {
      eEOM(i)=(eEOM_n-1)/(eEOM_n+1)*eEOM(i-1)+2/(eEOM_n+1)*EOM(i);
      //eEOM今=(n-1)/(n+1)*eEOM昨+2/(n+1)*EOM今。參數=9,<本人自創>
    }  
  }
  return EOM(), eEOM();
  //drawing the EOM and eEOM figures in the small windows.
  //EOM, eEOM=2,3,...,2000.
}
